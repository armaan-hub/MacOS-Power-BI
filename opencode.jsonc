{
  "$schema": "https://opencode.ai/config.json",
  // Analytics Studio (user rule 2026-11-16): OpenCode must never stop to wait for the user.
  // It may not ask questions; if a brief is unclear it ends its turn with a "BLOCKED:" message,
  // and the Team-Planner (Claude Opus) reads that and replies. See docs/OPENCODE_SUBAGENTS.md.
  "permissions": [
    { "action": "question", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "/Users/armaan/wt-*/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/claude-501/**", "effect": "allow" }
  ]
}
